<Project>

  <!--
    ONE place to change the target framework.

    net10.0 is the current LTS (supported to Nov 2028) and is what DECISIONS.md #6
    selected. It needs the .NET 10 SDK:
        https://dotnet.microsoft.com/download/dotnet/10.0

    If you want to build before installing that SDK, change the value below to
    net8.0 - the .NET 9 SDK already on this machine can build it. Note that .NET 8
    reaches end of support on 10 November 2026, so treat that as temporary.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      CS1591: XML docs are gradual.
      CA*: several recommended analyzers conflict with deliberate project conventions
      (P.Int helpers, from/to SP params, envelope Ok factories, legacy MD5 verify).
      Keep TreatWarningsAsErrors for real compiler warnings; suppress the conflicting CAs.
    -->
    <WarningsNotAsErrors>CS1591;CA1000;CA1305;CA1716;CA1720;CA1725;CA1848;CA1873;CA5351</WarningsNotAsErrors>
    <NoWarn>$(NoWarn);CS1591;CA1000;CA1305;CA1716;CA1720;CA1725;CA1848;CA1873;CA5351</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <!-- Package versions live here so every project stays in step. -->
  <PropertyGroup>
    <SqlClientVersion>6.0.1</SqlClientVersion>
    <SerilogAspNetVersion>9.0.0</SerilogAspNetVersion>
    <FluentValidationVersion>11.11.0</FluentValidationVersion>
    <SwashbuckleVersion>7.2.0</SwashbuckleVersion>
    <JwtBearerVersion>9.0.0</JwtBearerVersion>
  </PropertyGroup>

</Project>
