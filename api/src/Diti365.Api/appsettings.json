{
  "Database": {
    "ConnectionString": "",
    "CommandTimeoutSeconds": 30,
    "LongCommandTimeoutSeconds": 300,
    "RetryCount": 3,
    "RetryBaseDelayMs": 200,
    "SlowQueryWarnMs": 500
  },
  "Jwt": {
    "Issuer": "diti365",
    "Audience": "diti365-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Cors": {
    "AllowedOrigins": [ "https://app.diti365.com" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Data.SqlClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
