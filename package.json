{
  "name": "diti365",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web run typecheck",
    "check:routes": "node tools/check-routes.mjs",
    "check": "pnpm typecheck && pnpm typecheck:mobile && pnpm check:routes",
    "mobile": "pnpm --filter mobile exec expo start",
    "typecheck:mobile": "pnpm --filter mobile run typecheck"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "@types/react": "^19",
      "@types/react-dom": "^19"
    },
    "public-hoist-pattern": [
      "*@types/react*",
      "*@types/react-dom*"
    ]
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  }
}
